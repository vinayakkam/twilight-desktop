import QtQuick
import Quickshell
import Quickshell.Io

// Windows-style display settings: Laptop only / Duplicate / Extend / Second
// screen only, arrangement, resolution, refresh rate and scale. Writes
// ~/.config/hypr/monitors.lua (same file as nwg-displays), reloads Hyprland,
// and reverts automatically unless you press Keep within 15 seconds.
Column {
    id: root
    width: parent?.width ?? 600
    spacing: 8

    readonly property string luaPath: Quickshell.env("HOME") + "/.config/hypr/monitors.lua"
    property var mons: []                 // from `hyprctl -j monitors all`
    property string layout: "extend"      // laptop | duplicate | extend | external
    property string side: "right"         // where the external sits when extending
    property var pick: ({})               // name -> { res, rate, scale }
    property string previous: ""          // monitors.lua before Apply (for revert)
    property int countdown: 0

    readonly property var laptop: mons.find(m => m.name.startsWith("eDP")) ?? null
    readonly property var externals: mons.filter(m => !m.name.startsWith("eDP"))
    readonly property var ext: externals[0] ?? null

    Process {
        id: query
        running: true
        command: ["hyprctl", "-j", "monitors", "all"]
        stdout: StdioCollector {
            onStreamFinished: {
                const list = JSON.parse(text)
                root.mons = list
                const p = {}
                for (const m of list)
                    p[m.name] = { res: m.width + "x" + m.height, rate: Math.round(m.refreshRate * 100) / 100, scale: m.scale }
                root.pick = p
                const lap = list.find(m => m.name.startsWith("eDP"))
                const ex = list.find(m => !m.name.startsWith("eDP"))
                if (ex && ex.mirrorOf && ex.mirrorOf !== "none") root.layout = "duplicate"
                else if (lap && lap.disabled) root.layout = "external"
                else if (ex && ex.disabled) root.layout = "laptop"
                else root.layout = "extend"
                if (lap && ex && !ex.disabled && !lap.disabled) {
                    root.side = ex.x >= lap.x + lap.width / lap.scale ? "right"
                              : ex.x + ex.width / ex.scale <= lap.x ? "left"
                              : ex.y < lap.y ? "above" : "below"
                }
            }
        }
    }
    function refresh() { query.running = true }

    // ---- helpers over availableModes ("1920x1080@60.00Hz") ----
    function modes(m) { return (m?.availableModes ?? []).map(s => s.replace("Hz", "")) }
    function resolutions(m) {
        const seen = []
        for (const s of modes(m)) { const r = s.split("@")[0]; if (!seen.includes(r)) seen.push(r) }
        return seen
    }
    function rates(m, res) {
        return modes(m).filter(s => s.startsWith(res + "@")).map(s => Math.round(Number(s.split("@")[1]) * 100) / 100)
                       .filter((v, i, a) => a.indexOf(v) === i).sort((a, b) => b - a)
    }
    function setPick(name, key, value) {
        const p = Object.assign({}, pick)
        p[name] = Object.assign({}, p[name], { [key]: value })
        if (key === "res") p[name].rate = rates(mons.find(m => m.name === name), value)[0] ?? p[name].rate
        pick = p
    }
    function logical(name) {
        const p = pick[name]; if (!p) return { w: 1920, h: 1080 }
        const [w, h] = p.res.split("x").map(Number)
        return { w: Math.round(w / p.scale), h: Math.round(h / p.scale) }
    }

    // ---- build monitors.lua ----
    function luaFor() {
        const rule = (name, extra) => {
            const p = pick[name]
            return `hl.monitor({ output = "${name}", mode = "${p.res}@${p.rate}", scale = ${p.scale}${extra} })`
        }
        const out = ["-- Generated by Twilight Settings → Display. Change it there."]
        if (!laptop || !ext) {
            for (const m of mons) out.push(rule(m.name, `, position = "${m.x}x${m.y}"`))
            return out.join("\n") + "\n"
        }
        const L = laptop.name, E = ext.name, lw = logical(L), ew = logical(E)
        if (layout === "laptop") {
            out.push(rule(L, `, position = "0x0"`))
            for (const x of externals) out.push(`hl.monitor({ output = "${x.name}", disabled = true })`)
        } else if (layout === "external") {
            out.push(`hl.monitor({ output = "${L}", disabled = true })`)
            out.push(rule(E, `, position = "0x0"`))
        } else if (layout === "duplicate") {
            out.push(rule(L, `, position = "0x0"`))
            for (const x of externals) out.push(rule(x.name, `, position = "0x0", mirror = "${L}"`))
        } else {
            const pos = { right: [[0, 0], [lw.w, 0]], left: [[ew.w, 0], [0, 0]],
                          above: [[0, ew.h], [0, 0]], below: [[0, 0], [0, lw.h]] }[side]
            out.push(rule(L, `, position = "${pos[0][0]}x${pos[0][1]}"`))
            out.push(rule(E, `, position = "${pos[1][0]}x${pos[1][1]}"`))
            let x = Math.max(pos[0][0] + lw.w, pos[1][0] + ew.w)
            for (const o of externals.slice(1)) { out.push(rule(o.name, `, position = "${x}x0"`)); x += logical(o.name).w }
        }
        return out.join("\n") + "\n"
    }

    FileView { id: lua; path: root.luaPath; blockLoading: true; printErrors: false }
    function apply() {
        previous = lua.text()
        lua.setText(luaFor())
        Quickshell.execDetached(["sh", "-c", "sleep 0.3; hyprctl reload"])
        countdown = 15
        refreshLater.restart()
    }
    function keep() { countdown = 0 }
    function revert() {
        countdown = 0
        lua.setText(previous)
        Quickshell.execDetached(["sh", "-c", "sleep 0.3; hyprctl reload"])
        refreshLater.restart()
    }
    Timer { id: refreshLater; interval: 1500; onTriggered: root.refresh() }
    Timer { running: root.countdown > 0; interval: 1000; repeat: true
            onTriggered: { root.countdown--; if (root.countdown === 0) root.revert() } }

    // ================= UI =================

    // Keep-or-revert banner.
    Rectangle {
        visible: root.countdown > 0
        width: parent.width; height: 64; radius: Theme.radiusItem
        color: Qt.alpha(Theme.accent, 0.18)
        border.color: Theme.accent
        Label { anchors { left: parent.left; leftMargin: 18; verticalCenter: parent.verticalCenter }
            text: "Keep these display settings? Reverting in " + root.countdown + " s"; size: 14; weight: Font.DemiBold }
        Row {
            anchors { right: parent.right; rightMargin: 14; verticalCenter: parent.verticalCenter }
            spacing: 8
            HoverButton { width: 110; height: 36; radius: 18; color: hovered ? Qt.lighter(Theme.accent, 1.1) : Theme.accent
                onClicked: root.keep(); Label { anchors.centerIn: parent; text: "Keep changes"; size: 12; color: "#140b06"; weight: Font.DemiBold } }
            HoverButton { width: 90; height: 36; radius: 18; color: hovered ? Theme.hover : Theme.card
                onClicked: root.revert(); Label { anchors.centerIn: parent; text: "Revert"; size: 12 } }
        }
    }

    // Arrangement preview.
    Rectangle {
        width: parent.width; height: 190; radius: Theme.radiusPanel
        color: Theme.card
        Item {
            id: preview
            anchors { fill: parent; margins: 20 }
            readonly property var boxes: {
                if (!root.laptop) return []
                const L = root.laptop.name, lw = root.logical(L)
                if (!root.ext) return [{ n: L, x: 0, y: 0, w: lw.w, h: lw.h, label: "1" }]
                const E = root.ext.name, ew = root.logical(E)
                if (root.layout === "laptop") return [{ n: L, x: 0, y: 0, w: lw.w, h: lw.h, label: "1" }]
                if (root.layout === "external") return [{ n: E, x: 0, y: 0, w: ew.w, h: ew.h, label: "2" }]
                if (root.layout === "duplicate") return [{ n: L + " + " + E, x: 0, y: 0, w: lw.w, h: lw.h, label: "1 | 2" }]
                const pos = { right: [[0, 0], [lw.w, 0]], left: [[ew.w, 0], [0, 0]],
                              above: [[0, ew.h], [0, 0]], below: [[0, 0], [0, lw.h]] }[root.side]
                return [{ n: L, x: pos[0][0], y: pos[0][1], w: lw.w, h: lw.h, label: "1" },
                        { n: E, x: pos[1][0], y: pos[1][1], w: ew.w, h: ew.h, label: "2" }]
            }
            readonly property real totalW: Math.max(1, ...boxes.map(b => b.x + b.w))
            readonly property real totalH: Math.max(1, ...boxes.map(b => b.y + b.h))
            readonly property real k: Math.min(width / totalW, height / totalH) * 0.92
            Repeater {
                model: preview.boxes
                delegate: Rectangle {
                    required property var modelData
                    x: (preview.width - preview.totalW * preview.k) / 2 + modelData.x * preview.k + 3
                    y: (preview.height - preview.totalH * preview.k) / 2 + modelData.y * preview.k + 3
                    width: modelData.w * preview.k - 6; height: modelData.h * preview.k - 6
                    radius: 8
                    color: Qt.alpha(Theme.accent, 0.22); border.color: Theme.accent; border.width: 2
                    Column { anchors.centerIn: parent
                        Label { anchors.horizontalCenter: parent.horizontalCenter; text: modelData.label; size: 22; weight: Font.Bold }
                        Label { anchors.horizontalCenter: parent.horizontalCenter; text: modelData.n; size: 11; color: Theme.subtext } }
                }
            }
        }
    }

    // Multiple-display modes (Win + P style).
    Label { visible: root.ext !== null; text: "Multiple displays"; size: 13; weight: Font.DemiBold; color: Theme.subtext; topPadding: 6 }
    Grid {
        visible: root.ext !== null
        columns: 4
        spacing: 8
        Repeater {
            model: [["laptop", Icons.monitor, "Laptop screen only"], ["duplicate", Icons.copy, "Duplicate"],
                    ["extend", Icons.taskView, "Extend"], ["external", Icons.monitor, "Second screen only"]]
            delegate: HoverButton {
                required property var modelData
                width: (root.width - 24) / 4; height: 84
                radius: Theme.radiusItem
                active: root.layout === modelData[0]
                activeColor: Qt.alpha(Theme.accent, 0.25)
                color: active ? activeColor : hovered ? Theme.hover : Theme.card
                border.color: active ? Theme.accent : "transparent"; border.width: 2
                onClicked: root.layout = modelData[0]
                Column { anchors.centerIn: parent; spacing: 6
                    Glyph { anchors.horizontalCenter: parent.horizontalCenter; text: modelData[1]; size: 22; color: parent.parent.active ? Theme.accent : Theme.text }
                    Label { anchors.horizontalCenter: parent.horizontalCenter; text: modelData[2]; size: 12 } }
            }
        }
    }
    SettingRow {
        visible: root.ext !== null && root.layout === "extend"
        glyph: Icons.taskView; title: "Second screen position"; subtitle: "Where " + (root.ext?.name ?? "") + " sits next to the laptop"
        Choice { options: [["left", "Left"], ["right", "Right"], ["above", "Above"], ["below", "Below"]]; value: root.side; onPicked: v => root.side = v }
    }

    // Per-display settings.
    Repeater {
        model: root.mons.filter(m => !(root.layout === "laptop" && !m.name.startsWith("eDP"))
                                  && !(root.layout === "external" && m.name.startsWith("eDP")))
        delegate: Column {
            id: disp
            required property var modelData
            readonly property var p: root.pick[modelData.name] ?? ({ res: "", rate: 0, scale: 1 })
            width: root.width
            spacing: 6
            Label { text: (modelData.name.startsWith("eDP") ? "Laptop screen" : "Display") + " · " + modelData.name
                         + (modelData.make ? " · " + modelData.make + " " + modelData.model : "")
                    size: 13; weight: Font.DemiBold; color: Theme.subtext; topPadding: 8; width: parent.width }
            SettingRow { glyph: Icons.monitor; title: "Resolution"
                Choice { options: root.resolutions(disp.modelData).slice(0, 5).map(r => [r, r]); value: disp.p.res
                         onPicked: v => root.setPick(disp.modelData.name, "res", v) } }
            SettingRow { glyph: Icons.performance; title: "Refresh rate"
                Choice { options: root.rates(disp.modelData, disp.p.res).slice(0, 5).map(r => [r, r + " Hz"]); value: disp.p.rate
                         onPicked: v => root.setPick(disp.modelData.name, "rate", v) } }
            SettingRow { glyph: Icons.brightness; title: "Scale"; subtitle: "Size of text and apps"
                Choice { options: [[1, "100%"], [1.25, "125%"], [1.5, "150%"], [2, "200%"]]; value: disp.p.scale
                         onPicked: v => root.setPick(disp.modelData.name, "scale", v) } }
        }
    }

    Row {
        spacing: 8
        topPadding: 8
        HoverButton { width: 150; height: 40; radius: 20; color: hovered ? Qt.lighter(Theme.accent, 1.1) : Theme.accent
            enabled: root.countdown === 0; opacity: enabled ? 1 : 0.5
            onClicked: root.apply()
            Label { anchors.centerIn: parent; text: "Apply"; size: 13; color: "#140b06"; weight: Font.DemiBold } }
        HoverButton { width: 120; height: 40; radius: 20; color: hovered ? Theme.hover : Theme.card
            onClicked: root.refresh()
            Label { anchors.centerIn: parent; text: "Detect"; size: 13 } }
        HoverButton { width: 190; height: 40; radius: 20; color: hovered ? Theme.hover : Theme.card
            onClicked: Quickshell.execDetached(["nwg-displays"])
            Label { anchors.centerIn: parent; text: "Advanced (nwg-displays)"; size: 13 } }
    }
}
