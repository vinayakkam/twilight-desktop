pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// User settings, edited in the Settings app. Stored in
// ~/.config/twilight/settings.json. Hyprland-side settings are written to
// ~/.config/hypr/twilight.lua and the idle policy to hypridle.conf, then
// applied live - no hand-editing of configs needed.
Singleton {
    id: root

    readonly property string home: Quickshell.env("HOME")
    readonly property string wallpaperDir: home + "/.local/share/twilight/wallpapers"
    property alias s: adapter

    FileView {
        id: file
        path: root.home + "/.config/twilight/settings.json"
        blockLoading: true
        printErrors: false
        watchChanges: true
        onFileChanged: reload()
        onLoadFailed: err => { if (err === FileViewError.FileNotFound) writeAdapter() }
        onAdapterUpdated: writeAdapter()

        JsonAdapter {
            id: adapter
            // Personalisation
            property string theme: "launch"
            property string wallpaper: root.home + "/.local/share/twilight/wallpapers/denali-wonder-lake.jpg"
            property bool clock24: false
            property bool showMeters: true
            // Taskbar: "dodge" (hide only for maximised windows), "always", "autohide"
            property string taskbarMode: "dodge"
            // Windows
            property bool titleBars: true
            property bool buttonsLeft: false
            property string gaps: "normal"   // none | small | normal | wide
            property int rounding: 12
            property bool blur: true
            property bool animations: true
            // Input
            property bool naturalScroll: true
            property bool tapToClick: true
            property real pointerSpeed: 0
            property string kbLayout: "us"
            // Power & idle (minutes, 0 = never)
            property int dimAfter: 2
            property int lockAfter: 5
            property int screenOffAfter: 6
            property int sleepAfter: 20
            // Display
            property int nightTemp: 4200
            // Notifications
            property int toastSeconds: 5
            // Sign-in
            property bool fingerprintUnlock: true
            property bool lockOnSleep: true
            // Display / input / accessibility
            property real laptopScale: 1
            property bool leftHanded: false
            property int repeatDelay: 400
            property int repeatRate: 30
            property int cursorSize: 24
            // Time & apps
            property bool weekStartsMonday: false
            property bool showRecentFiles: true
            property var autostart: []
            property bool welcomeShown: false
            // Dolphin + Discover icons in the Twilight accent (ColorFlow-Twilight,
            // which inherits every other icon from KDE's ColorFlow theme).
            property bool tintedIcons: true
        }
    }

    // ---------------- Theme presets ----------------
    // "launch" is sampled from the rocket-launch painting.
    readonly property var themes: ({
        launch:   { name: "Launch",   accent: "#f2683a", accent2: "#f3b651", base: "#0d1428", gtk: "orange" },
        twilight: { name: "Twilight", accent: "#6c8cff", accent2: "#a46bff", base: "#0b0b14", gtk: "blue" },
        sky:      { name: "Sky",      accent: "#5eb7d0", accent2: "#1f5fa3", base: "#0b1422", gtk: "teal" },
        ember:    { name: "Ember",    accent: "#cd4126", accent2: "#563353", base: "#140d14", gtk: "red" },
        meadow:   { name: "Meadow",   accent: "#5fd39b", accent2: "#3aa6b9", base: "#0a1614", gtk: "green" },
    })
    readonly property var theme: themes[s.theme] ?? themes.launch

    // ---------------- Apply to Hyprland / idle / GTK ----------------
    function hex(c) { return c.replace("#", "") }

    function hyprLua() {
        const g = { none: [0, 0], small: [2, 4], normal: [4, 8], wide: [8, 16] }[s.gaps] ?? [4, 8]
        return `-- Generated by Twilight Settings. Edit in the Settings app, not here.
return {
    gaps_in = ${g[0]}, gaps_out = ${g[1]}, rounding = ${s.rounding},
    blur = ${s.blur}, animations = ${s.animations},
    border_a = "rgba(${hex(theme.accent)}ee)", border_b = "rgba(${hex(theme.accent2)}ee)",
    natural_scroll = ${s.naturalScroll}, tap_to_click = ${s.tapToClick},
    sensitivity = ${Number(s.pointerSpeed).toFixed(2)}, kb_layout = "${s.kbLayout.replace(/[^a-z,()_-]/gi, "")}",
    title_bars = ${s.titleBars}, buttons_left = ${s.buttonsLeft},
    laptop_scale = ${s.laptopScale}, left_handed = ${s.leftHanded},
    repeat_delay = ${s.repeatDelay}, repeat_rate = ${s.repeatRate}, cursor_size = ${s.cursorSize},
}
`
    }

    function idleConf() {
        const L = (min, on, off) => min > 0
            ? `listener {\n    timeout = ${min * 60}\n    on-timeout = ${on}\n${off ? "    on-resume = " + off + "\n" : ""}}\n\n` : ""
        return `# Generated by Twilight Settings (Power page). Edit there, not here.
general {
    lock_cmd = pidof hyprlock || hyprlock --immediate-render
    before_sleep_cmd = ${s.lockOnSleep ? "loginctl lock-session" : "true"}
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'
    ignore_dbus_inhibit = false
}

` + L(s.dimAfter, "brightnessctl -s set 15%-", "brightnessctl -r")
  + L(s.lockAfter, "loginctl lock-session", "")
  + L(s.screenOffAfter, `hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'`, `hyprctl dispatch 'hl.dsp.dpms({ action = "on" })'`)
  + L(s.sleepAfter, "systemctl suspend", "")
    }

    FileView { id: luaOut; path: root.home + "/.config/hypr/twilight.lua"; blockLoading: true; printErrors: false }
    FileView { id: kdeOut; path: root.home + "/.config/hypr/kde-overrides/kdeglobals"; blockLoading: true; printErrors: false }
    FileView { id: authOut; path: root.home + "/.config/hypr/hyprlock-auth.conf"; blockLoading: true; printErrors: false }
    FileView { id: idleOut; path: root.home + "/.config/hypr/hypridle.conf"; blockLoading: true; printErrors: false }

    // Debounced: sliders fire many changes.
    Timer { id: applyTimer; interval: 400; onTriggered: root.applyNow() }
    function apply() { applyTimer.restart() }
    function set(key, value) { s[key] = value; apply() }

    // Only touches files (and reloads) when something actually changed.
    function applyNow() {
        const lua = hyprLua()
        if (lua !== luaOut.text()) {
            luaOut.setText(lua)
            Quickshell.execDetached(["sh", "-c", "sleep 0.2; hyprctl reload"])
        }
        const idle = idleConf()
        if (idle !== idleOut.text()) {
            idleOut.setText(idle)
            // hypridle only runs inside Twilight (KDE doesn't use it).
            Quickshell.execDetached(["sh", "-c", "pkill -u \"$USER\" -x hypridle; sleep 0.3; setsid hypridle >/dev/null 2>&1 &"])
        }
        const auth = `# Generated by Twilight Settings (Sign-in page). Edit there, not here.
auth {
    pam {
        enabled = true
    }
    fingerprint {
        enabled = ${s.fingerprintUnlock}
        ready_message = Touch the fingerprint sensor or type your password
        present_message = Reading fingerprint…
        retry_delay = 250
    }
}
`
        if (auth !== authOut.text()) authOut.setText(auth)
        const iconTheme = s.tintedIcons ? "ColorFlow-Twilight" : "ColorFlow.Agresive.Color"
        const kde = `# Hyprland-only overrides of KDE settings (searched before ~/.config/kdedefaults).
# Written by Twilight Settings → Personalisation. KDE never reads this folder.
[Icons]
Theme=${iconTheme}
`
        if (kde !== kdeOut.text()) kdeOut.setText(kde)
        Quickshell.execDetached(["sh", "-c",
            `hyprctl setcursor breeze_cursors ${s.cursorSize} >/dev/null 2>&1;
             gsettings set org.gnome.desktop.interface cursor-size ${s.cursorSize};
             gsettings set org.gnome.desktop.interface icon-theme ${s.tintedIcons ? "ColorFlow-Twilight" : "ColorFlow.Agresive.Color"};
             gsettings set org.gnome.desktop.interface accent-color ${theme.gtk} 2>/dev/null;
             gsettings set org.gnome.desktop.wm.preferences button-layout '${s.buttonsLeft ? "minimize,maximize,close:" : ":minimize,maximize,close"}';
             ln -sfn "${s.wallpaper}" "${home}/.local/share/twilight/wallpaper.jpg"`])
    }

    Component.onCompleted: applyTimer.restart()
    Connections { target: adapter; function onThemeChanged() { root.apply() } }
}
